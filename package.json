{
  "name": "netviet-sales-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NetViet Sales OS — lớp cấu hình chạy local (Cloudflare Worker + D1 + KV)",
  "scripts": {
    "assets": "node local/sync-assets.mjs",
    "dev": "npm run assets && wrangler dev --local --port 8787",
    "start": "npm run dev",
    "clean": "rm -rf public .wrangler",
    "reset-db": "rm -rf .wrangler/state/v3/d1"
  },
  "devDependencies": {
    "wrangler": "4.119.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true,
    "fsevents@2.3.3": true
  }
}
